{
  "name": "andreas-radio-social",
  "main": "./index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://andreaswallevik.no,https://www.andreaswallevik.no,http://localhost:4321,http://127.0.0.1:4321"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "andreas-radio-social",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ]
}
