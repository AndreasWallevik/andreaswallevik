---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import VisualWorkCard from '../../components/VisualWorkCard.astro';
import ContactCallout from '../../components/ContactCallout.astro';
import { isSoundWork, listedProjects, selectedWork, visualWork } from '../../lib/projects';
import { withBase } from '../../config/site';

const selected = (await selectedWork()).filter(isSoundWork);
const projects = (await listedProjects()).filter(isSoundWork);
const videos = (await visualWork()).filter((project) =>
  isSoundWork(project) && !project.data.featured && !project.data.showInProjects
);
---
<BaseLayout title="Sound — Andreas Wallevik" description="Music production, songwriting, and sound for moving image by Andreas Wallevik.">
  <section class="page-intro shell">
    <p class="eyebrow"><a href={withBase('/work/')}>Work</a> / Sound</p>
    <h1>Sound<span class="accent-period">.</span></h1>
    <p>Music production, songwriting, and sound for moving image.</p>
  </section>
  {selected.length > 0 && <section class="work-section shell" aria-labelledby="sound-selected-heading">
    <div class="section-heading"><div><p class="eyebrow">01 / Portfolio</p><h2 id="sound-selected-heading">Selected <em>work</em></h2></div></div>
    <div class="credit-grid">{selected.map((project, index) => <ProjectCard project={project} index={index} variant="feature" />)}</div>
  </section>}
  {projects.length > 0 && <section class="projects-section shell" aria-labelledby="sound-projects-heading">
    <div class="section-heading"><div><p class="eyebrow">02 / Projects</p><h2 id="sound-projects-heading"><em>Projects</em></h2></div></div>
    <div class="projects-grid">{projects.map((project, index) => <ProjectCard project={project} index={index} variant="compact" />)}</div>
  </section>}
  {videos.length > 0 && <section class="visual-work-section shell" aria-labelledby="sound-video-heading">
    <div class="section-heading"><div><p class="eyebrow">03 / Sound & image</p><h2 id="sound-video-heading">Music in <em>motion</em></h2></div><a class="text-link" href={withBase('/work/visual/')}>Explore visual work <span aria-hidden="true">↗</span></a></div>
    <div class="visual-grid">{videos.map((project) => <VisualWorkCard project={project} />)}</div>
  </section>}
  <ContactCallout />
</BaseLayout>
