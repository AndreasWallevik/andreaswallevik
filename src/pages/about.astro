---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCallout from '../components/ContactCallout.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/portraits/andreas_2.jpg';

const about = await getEntry('pages', 'about');
if (!about) throw new Error('About content is missing.');
const { Content } = await render(about);
---
<BaseLayout title="About — Andreas Wallevik" description={about.data.description}>
  <section class="page-intro shell">
    <p class="eyebrow">About / A brief introduction</p>
    <h1>Behind the <em>work</em><span class="accent-period">.</span></h1>
    <p>Songwriting, production and the spaces in between.</p>
  </section>
  <section class="about-page shell">
    <div class="about-visual">
      <Image src={portrait} alt="Portrait of Andreas Wallevik seated in a dark track jacket" format="webp" quality={82} loading="lazy" />
      <div class="about-mark" aria-hidden="true"><span>A</span><span>W</span></div>
    </div>
    <div class="prose about-prose"><Content /></div>
  </section>
  <ContactCallout />
</BaseLayout>
