---
interface Props { initialArtworkSrc: string; }
const { initialArtworkSrc } = Astro.props;
---

<div class="radio-visualizer" data-radio-visualizer>
  <div class="radio-art" data-visualizer-stage data-running="false">
    <img data-artwork src={initialArtworkSrc} alt="Orange starburst on a dark green background" width="600" height="600" />
    <canvas data-visualizer-canvas aria-hidden="true"></canvas>
    <span class="radio-art-corner" aria-hidden="true">SKRRR / 001</span>
  </div>
  <div class="radio-visualizer-controls">
    <button type="button" data-visualizer-toggle aria-pressed="false">Visualizer off</button>
    <label>
      <span>Mode</span>
      <select data-visualizer-mode aria-label="Visualizer mode">
        <option value="oscilloscope">Oscilloscope</option>
        <option value="psychedelic">Psychedelic</option>
        <option value="artwork">Artwork reactive</option>
      </select>
    </label>
  </div>
</div>

<style>
  .radio-visualizer { min-width: 0; }
  .radio-art { position: relative; width: 100%; aspect-ratio: 1; overflow: hidden; background: #1b2620; }
  .radio-art img, .radio-art canvas { display: block; width: 100%; height: 100%; }
  .radio-art img { object-fit: cover; transform-origin: center; }
  .radio-art canvas { position: absolute; inset: 0; display: none; pointer-events: none; }
  .radio-art[data-running="true"] canvas { display: block; }
  .radio-art-corner { position: absolute; left: 1rem; bottom: 1rem; z-index: 1; padding: .25rem .4rem; background: var(--deep); color: var(--paper); font-size: .65rem; font-weight: 700; letter-spacing: .12em; }
  .radio-visualizer-controls { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; padding-top: .8rem; }
  .radio-visualizer-controls button, .radio-visualizer-controls select { min-height: 36px; border: 1px solid #66746b; border-radius: 0; background: transparent; color: var(--paper); font: inherit; font-size: .72rem; font-weight: 700; cursor: pointer; }
  .radio-visualizer-controls button { padding: .45rem .75rem; }
  .radio-visualizer-controls button[aria-pressed="true"] { border-color: #d1df8e; color: #d1df8e; }
  .radio-visualizer-controls button:disabled { cursor: not-allowed; opacity: .55; }
  .radio-visualizer-controls label { display: inline-flex; align-items: center; gap: .5rem; color: #bcc8bc; font-size: .68rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .radio-visualizer-controls select { max-width: 160px; padding: .4rem .55rem; letter-spacing: 0; text-transform: none; }
  .radio-visualizer-controls select option { background: var(--deep); color: var(--paper); }
  .radio-visualizer-controls :is(button, select):hover:not(:disabled) { border-color: #d1df8e; }
  @media (max-width: 760px) { .radio-visualizer { width: min(100%, 440px); } }
</style>
