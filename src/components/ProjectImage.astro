---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { withBase } from '../config/site';

interface Props {
  src: string | ImageMetadata;
  alt: string;
  loading?: 'eager' | 'lazy';
}

const { src, alt, loading = 'lazy' } = Astro.props;
---
{typeof src === 'string'
  ? <img src={withBase(src)} alt={alt} loading={loading} width="1200" height="900" />
  : <Image src={src} alt={alt} loading={loading} format="webp" quality={82} />}
