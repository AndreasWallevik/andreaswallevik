---
import BaseLayout from '../layouts/BaseLayout.astro';
import SamplyPlayer from './SamplyPlayer.astro';
import { listeningNotice, type ListeningPlaylist } from '../config/listening';
import { site, withBase } from '../config/site';

interface Props { playlist: ListeningPlaylist; }

const { playlist } = Astro.props;
---
<BaseLayout title={playlist.pageTitle} description={playlist.introduction} noindex>
  <article class="listen-detail shell">
    <header class="listen-heading">
      <p class="eyebrow">Andreas Wallevik / Listening</p>
      <h1>{playlist.title}<span class="accent-period">.</span></h1>
      <p>{playlist.introduction}</p>
    </header>

    <SamplyPlayer embedUrl={playlist.embedUrl} title={playlist.title} />

    {playlist.creditGroups.length > 0 && <section class="listen-credits" aria-label="Playlist credits">
      {playlist.creditGroups.map((group) => <div class="listen-credit-group">
        <h2 class="eyebrow">{group.heading}</h2>
        <ul>{group.entries.map((entry) => <li>
          <h3>{entry.title}</h3>
          <div>
            <p>{entry.contribution}</p>
            {'collaborators' in entry && <p>Collaborators: {entry.collaborators.join(', ')}</p>}
          </div>
        </li>)}</ul>
      </div>)}
    </section>}

    <section class="listen-contact" aria-labelledby="listen-contact-heading">
      <h2 id="listen-contact-heading" class="eyebrow">CONTACT</h2>
      <div>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={withBase('/')}>andreaswallevik.no <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="listen-notice" aria-labelledby="listen-notice-heading">
      <h2 id="listen-notice-heading" class="eyebrow">NOTICE</h2>
      <p>{listeningNotice}</p>
    </section>
  </article>
</BaseLayout>

<style>
  .listen-detail { padding-block: clamp(2rem, 3vw, 2.5rem) 6rem; }
  .listen-heading { padding-bottom: 1.25rem; }
  .listen-heading h1 { margin: .8rem 0 .6rem; font-size: clamp(2.5rem, 4.5vw, 4.25rem); font-weight: 500; line-height: 1; letter-spacing: -.07em; }
  .listen-heading > p:last-child { max-width: 800px; margin: 0; font-size: clamp(1rem, 1.3vw, 1.15rem); line-height: 1.5; }
  .listen-credits { margin-top: 3.5rem; border-top: 1px solid var(--line); }
  .listen-credit-group { padding-top: 2rem; }
  .listen-credit-group + .listen-credit-group { margin-top: 2rem; border-top: 1px solid var(--line); }
  .listen-credit-group ul { list-style: none; padding: 0; margin: 1rem 0 0; }
  .listen-credit-group li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 2rem; padding: 1.35rem 0; border-bottom: 1px solid var(--line); }
  .listen-credit-group h3 { margin: 0; font-size: clamp(1.15rem, 2vw, 1.5rem); font-weight: 500; letter-spacing: -.035em; line-height: 1.3; }
  .listen-credit-group li p { margin: 0 0 .4rem; color: var(--muted); font-size: .9rem; line-height: 1.5; }
  .listen-contact, .listen-notice { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 2rem; padding-block: 2rem; border-top: 1px solid var(--line); }
  .listen-contact { margin-top: 3.5rem; }
  .listen-contact > div { display: flex; flex-wrap: wrap; gap: .7rem 2rem; }
  .listen-contact a { font-size: .95rem; font-weight: 600; text-decoration: underline; text-underline-offset: .2em; overflow-wrap: anywhere; }
  .listen-contact a:hover { color: var(--accent); }
  .listen-notice p { max-width: 700px; margin: 0; color: var(--muted); font-size: .9rem; line-height: 1.55; }
  @media (max-width: 640px) {
    .listen-detail { padding-block: 2rem 4rem; }
    .listen-heading h1 { font-size: clamp(1.85rem, 8vw, 3.1rem); }
    .listen-credit-group li, .listen-contact, .listen-notice { grid-template-columns: 1fr; gap: .75rem; }
    .listen-credit-group li { padding-block: 1.2rem; }
  }
</style>
